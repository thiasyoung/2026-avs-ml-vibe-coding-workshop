# Project environment and Python cache
.venv/
__pycache__/
*.py[cod]

# Jupyter creates these automatically
.ipynb_checkpoints/

# Notebook-run outputs are tracked when an authorized Issue explicitly asks to
# preserve them. Keep only disposable or very large training artifacts ignored.
**/outputs/**/checkpoints/
**/outputs/**/tensorboard/
**/outputs/**/*.ckpt
**/outputs/**/*.pt
**/outputs/**/*.pth

# Superseded course notebooks are retained locally for provenance, not distribution
**/archive/

# Local operating-system and editor files
.DS_Store
Thumbs.db
.vscode/
