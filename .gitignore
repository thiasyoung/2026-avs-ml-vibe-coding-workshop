# Project environment and Python cache
.venv/
__pycache__/
*.py[cod]

# Jupyter creates these automatically
.ipynb_checkpoints/

# Quarto builds are published as Pages artifacts, not source commits.
/_site/
/.quarto/
**/*.quarto_ipynb

# Generated workshop artifacts are ignored by default. An isolated runner
# output-migration step must select and stage only its intended deliverables.
**/outputs/

# Superseded course notebooks are retained locally for provenance, not distribution
**/archive/

# Local operating-system and editor files
.DS_Store
Thumbs.db
.vscode/
